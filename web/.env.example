# Browserbase (stealth browser infra)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Stagehand model provider (OpenAI or Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which environment Stagehand should run in: LOCAL (playwright on this box) or BROWSERBASE
STAGEHAND_ENV=LOCAL

# Which LLM to use for act()/extract() planning
STAGEHAND_MODEL=gpt-4o-mini
